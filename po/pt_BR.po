#: orfeuscribe/__main__.py:153
msgid "Orfeu Scribe needs the system Python with GTK 4, libadwaita and GStreamer. Start it from the installed launcher."
msgstr "O Orfeu Scribe precisa do Python do sistema com GTK 4, libadwaita e GStreamer. Abra-o pelo lançador instalado."

#: orfeuscribe/audio.py:57
msgid "The chosen microphone is not available. Pick another one in Settings."
msgstr "O microfone escolhido não está disponível. Escolha outro nas Configurações."

