msgstr "Depois de 15 s de fala, transcreve o áudio novo a cada 6 s para mostrar o andamento na pílula. Multiplica as chamadas ao serviço de fala."

#: orfeuscribe/window.py:1181
msgid "Keep history for (days)"
msgstr "Guardar o histórico por (dias)"

#: orfeuscribe/window.py:1182
msgid "0 keeps it until you delete it."
msgstr "0 guarda até você excluir."

#: orfeuscribe/window.py:1184
msgid "Apply"
msgstr "Aplicar"

#: orfeuscribe/window.py:1187
msgid "Keep audio of the last dictations"
msgstr "Guardar o áudio dos últimos ditados"

#: orfeuscribe/window.py:1188
msgid "0 keeps no audio in the history."
msgstr "0 não guarda áudio no histórico."

#: orfeuscribe/window.py:1192
msgid "Recovery"
msgstr "Recuperação"

#: orfeuscribe/window.py:1193
msgid "The audio of failed or cancelled dictations is kept for 24 hours in a private folder so you can recover them, then deleted."
msgstr "O áudio de ditados que falharam ou foram cancelados fica 24 horas numa pasta privada para você recuperá-los; depois é apagado."

#: orfeuscribe/window.py:1203
msgid "The history will be kept until you delete it."
msgstr "O histórico será guardado até você excluí-lo."

#: orfeuscribe/window.py:1205
msgid "Apply history retention?"
msgstr "Aplicar a retenção do histórico?"

#: orfeuscribe/window.py:1206
#, python-brace-format
msgid "Entries older than {days} day will be deleted now and from then on, with their audio."
msgid_plural "Entries older than {days} days will be deleted now and from then on, with their audio."
msgstr[0] "As entradas com mais de {days} dia serão excluídas agora e daqui em diante, com o áudio."
msgstr[1] "As entradas com mais de {days} dias serão excluídas agora e daqui em diante, com o áudio."

#: orfeuscribe/window.py:1211
msgid "Delete Older Entries"
msgstr "Excluir Entradas Antigas"

#: orfeuscribe/window.py:1223
#, python-brace-format
msgid "{count} old entry deleted."
msgid_plural "{count} old entries deleted."
msgstr[0] "{count} entrada antiga excluída."
msgstr[1] "{count} entradas antigas excluídas."

#: orfeuscribe/window.py:1226
msgid "Could not apply the retention."
msgstr "Não foi possível aplicar a retenção."

#: orfeuscribe/window.py:1237
msgid "Notes Folder"
msgstr "Pasta de Notas"

#: orfeuscribe/window.py:1238
msgid "Optional. When a folder is set, dictations that start with “note:” are appended to a daily Markdown file there instead of being pasted."
msgstr "Opcional. Com uma pasta definida, os ditados que começam com “nota:” são acrescentados a um arquivo Markdown do dia nessa pasta, em vez de colados."

#: orfeuscribe/window.py:1241
msgid "Folder"
msgstr "Pasta"

#: orfeuscribe/window.py:1244
msgid "Turn off"
msgstr "Desligar"

#: orfeuscribe/window.py:1246
