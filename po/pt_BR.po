#: orfeuscribe/providers/__init__.py:53 orfeuscribe/service.py:387
msgid "No speech service is configured. Open Settings → Service."
msgstr "Nenhum serviço de fala configurado. Abra Configurações → Serviço."

#: orfeuscribe/providers/__init__.py:57
msgid "This needs a text revision service. Turn it on in Settings → Service."
msgstr "Isto precisa de um serviço de revisão de texto. Ative-o em Configurações → Serviço."

#: orfeuscribe/providers/openai_compat.py:48
msgid "The service rejected the request (HTTP 400). Check the model name."
msgstr "O serviço recusou o pedido (HTTP 400). Confira o nome do modelo."

#: orfeuscribe/providers/openai_compat.py:49
msgid "The service rejected the API key. Check it in Settings → Service."
msgstr "O serviço recusou a chave de API. Confira-a em Configurações → Serviço."

#: orfeuscribe/providers/openai_compat.py:50
msgid "The service refused this request. Check the account's permissions."
msgstr "O serviço recusou este pedido. Confira as permissões da conta."

#: orfeuscribe/providers/openai_compat.py:51
msgid "Endpoint or model not found. Check the server URL and the model name."
msgstr "Endereço ou modelo não encontrado. Confira a URL do servidor e o nome do modelo."

#: orfeuscribe/providers/openai_compat.py:52 orfeuscribe/providers/openai_compat.py:167
msgid "The audio is too large for the service."
msgstr "O áudio é grande demais para o serviço."

#: orfeuscribe/providers/openai_compat.py:53
msgid "Rate limit or quota reached. Wait a moment and try again."
msgstr "Limite de uso ou cota atingido. Aguarde um pouco e tente novamente."

#: orfeuscribe/providers/openai_compat.py:54
#, python-brace-format
msgid "The service returned an error (HTTP {status}). Try again."
msgstr "O serviço retornou um erro (HTTP {status}). Tente novamente."

#: orfeuscribe/providers/openai_compat.py:60
msgid "Use an https:// server URL (http:// is accepted only for this computer)."
msgstr "Use uma URL de servidor https:// (http:// só é aceito para este computador)."

#: orfeuscribe/providers/openai_compat.py:74
msgid "The API key could not be read."
msgstr "Não foi possível ler a chave de API."

#: orfeuscribe/providers/openai_compat.py:94
msgid "Could not reach the service. Check the connection and the server URL."
msgstr "Não foi possível alcançar o serviço. Confira a conexão e a URL do servidor."

#: orfeuscribe/providers/openai_compat.py:96
msgid "The service returned an invalid response."
msgstr "O serviço retornou uma resposta inválida."

#: orfeuscribe/providers/openai_compat.py:103
msgid "The service did not list any models."
msgstr "O serviço não listou nenhum modelo."

#: orfeuscribe/providers/openai_compat.py:165
msgid "The audio is empty."
msgstr "O áudio está vazio."

#: orfeuscribe/providers/openai_compat.py:172
msgid "No speech was found in this audio. Check the microphone and try again."
msgstr "Não foi encontrada fala neste áudio. Confira o microfone e tente novamente."

#: orfeuscribe/providers/openai_compat.py:213
msgid "The model reached its length limit. Your transcript was kept."
msgstr "O modelo atingiu o limite de tamanho. Sua transcrição foi preservada."

#: orfeuscribe/providers/openai_compat.py:219
msgid "The model returned no text. Your transcript was kept."
msgstr "O modelo não retornou texto. Sua transcrição foi preservada."

#: orfeuscribe/providers/openai_compat.py:246
msgid "The answer did not come in a safe format. The selection was kept."
msgstr "A resposta não veio em formato seguro. A seleção foi preservada."

